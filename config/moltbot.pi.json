{
  "agents": {
    "defaults": {
      "workspace": "/home/bpwonka/apps/moltbot/BRAIN",
      "thinkingDefault": "off",
      "bootstrapMaxChars": 1500,
      "contextTokens": 8000,

      "contextPruning": {
        "mode": "cache-ttl",
        "keepLastAssistants": 2,
        "softTrimRatio": 0.25,
        "hardClearRatio": 0.60,
        "minPrunableToolChars": 300
      },

      "compaction": {
        "mode": "safeguard",
        "maxHistoryShare": 0.20,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 6000
        }
      },

      "memorySearch": {
        "enabled": true,
        "provider": "openai",
        "model": "text-embedding-3-small",
        "sources": ["memory"],
        "store": {
          "driver": "sqlite",
          "path": "/home/bpwonka/apps/moltbot/BRAIN/memory/{agentId}.sqlite",
          "vector": { "enabled": true }
        },
        "chunking": {
          "tokens": 400,
          "overlap": 60
        },
        "sync": {
          "onSessionStart": true,
          "onSearch": false,
          "watch": true,
          "watchDebounceMs": 3000,
          "intervalMinutes": 0
        },
        "query": {
          "maxResults": 3,
          "minScore": 0.62,
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.70,
            "textWeight": 0.30
          },
          "boosts": [
            { "field": "content", "contains": "WEIGHT:high", "factor": 1.4 },
            { "field": "content", "contains": "WEIGHT:medium", "factor": 1.0 },
            { "field": "content", "contains": "WEIGHT:low", "factor": 0.65 }
          ]
        },
        "cache": {
          "enabled": true,
          "maxEntries": 100
        }
      },

      "subagents": {
        "model": "openai/gpt-4o-mini",
        "maxConcurrent": 1
      },

      "heartbeat": null,
      "timeoutSeconds": 45,
      "typingMode": "thinking",
      "maxConcurrent": 1,

      "hooks": {
        "onSessionEnd": "bash /home/bpwonka/apps/moltbot/scripts/session-extractor.sh"
      }
    },

    "list": [
      {
        "id": "ecarg",
        "default": true,
        "model": {
          "primary": "openai/gpt-4o-mini",
          "fallbacks": ["openai/gpt-5.4-mini"]
        },
        "subagents": {
          "allowAgents": ["ecarg-deep"]
        }
      },
      {
        "id": "ecarg-deep",
        "model": {
          "primary": "openai/gpt-5.5",
          "fallbacks": ["openai/gpt-5.4"]
        },
        "timeoutSeconds": 180
      }
    ]
  },

  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan"
  },

  "discovery": {
    "mdns": {
      "mode": "full"
    }
  },

  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "OPENAI_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-4o-mini",
            "name": "GPT-4o Mini",
            "contextWindow": 128000,
            "reasoning": false,
            "input": ["text", "image"]
          },
          {
            "id": "gpt-5.4-mini",
            "name": "GPT-5.4 Mini (fallback)",
            "contextWindow": 400000,
            "reasoning": false,
            "input": ["text", "image"]
          },
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5",
            "contextWindow": 1000000,
            "reasoning": true,
            "input": ["text", "image"]
          },
          {
            "id": "gpt-5.4",
            "name": "GPT-5.4 (fallback)",
            "contextWindow": 1000000,
            "reasoning": true,
            "input": ["text", "image"]
          }
        ]
      }
    }
  }
}
