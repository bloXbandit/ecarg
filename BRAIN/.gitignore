# Keep structure but ignore runtime/session state
sessions/*
!sessions/.gitkeep
!sessions/mortgage_mode.json

# Downloaded files — don't commit
downloads/*
!downloads/.gitkeep

# Agent state files are runtime — don't commit changes after initial setup
# (comment these out if you want to track state in git)
agents/*_state.md

# Token logs — runtime, don't commit
logs/*
!logs/.gitkeep
